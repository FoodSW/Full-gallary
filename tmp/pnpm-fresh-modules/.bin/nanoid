#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/tmp/pnpm-fresh-vstore/nanoid@5.1.16/node_modules/nanoid/node_modules:/tmp/pnpm-fresh-vstore/nanoid@5.1.16/node_modules:/tmp/pnpm-fresh-vstore/node_modules"
else
  export NODE_PATH="/tmp/pnpm-fresh-vstore/nanoid@5.1.16/node_modules/nanoid/node_modules:/tmp/pnpm-fresh-vstore/nanoid@5.1.16/node_modules:/tmp/pnpm-fresh-vstore/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../nanoid/bin/nanoid.js" "$@"
else
  exec node  "$basedir/../nanoid/bin/nanoid.js" "$@"
fi
